{
  "name": "openfort-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.mjs\"",
    "demo": "vite --mode demo",
    "fixture": "node tests/fixture-gateway.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "check": "npm run check:standalone && npm run check:architecture && npm run lint && npm run format:check && npm test && npm run build",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/{contracts,resource,recipe,tool,capability,adapter,workflow,journey}/**/*.ts\"",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:security": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@ethersproject/address": "5.8.0",
    "@ethersproject/transactions": "5.8.0",
    "@openfort/openfort-js": "2.6.0",
    "framer-motion": "11.3.19",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "prettier": "3.6.2",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  },
  "overrides": {
    "axios": "1.20.0",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=26.5.0 <27",
    "npm": ">=11.17.0 <12"
  },
  "description": "Standalone Species wallet client with Openfort recovery, encrypted portability and a credential-free UI demo.",
  "repository": {
    "type": "git",
    "url": "https://github.com/syn-S2B/openfortWallet.git"
  },
  "packageManager": "npm@11.17.0"
}
